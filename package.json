{
  "name": "withframe",
  "version": "0.0.1",
  "description": "WithFrame component registry CLI",
  "type": "module",
  "main": "dist/index.mjs",
  "homepage": "https://github.com/WithFrame/withframe-npx#readme",
  "bugs": {
    "url": "https://github.com/WithFrame/withframe-npx/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WithFrame/withframe-npx.git"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "withframe": "dist/index.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "withframe",
    "cli",
    "react-native",
    "expo",
    "components",
    "registry",
    "npx"
  ],
  "author": "WithFrame",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^25.5.2",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.1",
    "tsdown": "^0.21.7",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.58.0",
    "vitest": "^4.1.3"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.4.0",
    "awilix": "^13.0.3",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "figlet": "^1.11.0",
    "gradient-string": "^3.0.0",
    "jimp": "^1.6.1",
    "open": "^10.2.0",
    "ora": "^9.3.0"
  }
}
